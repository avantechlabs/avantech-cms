{
  "name": "avantech-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/devStack.js",
    "dev:stack": "vite --host 0.0.0.0 --port 51730 --strictPort",
    "dev:cms": "pnpm run dev:stack",
    "build": "vite build",
    "dev:example": "pnpm --filter site-demo dev",
    "dev:project-a": "pnpm --filter site-demo dev",
    "dev:project-b": "pnpm --filter sable-demo dev",
    "dev:examples": "pnpm --parallel --filter site-demo --filter sable-demo dev",
    "check:prod-env": "node scripts/checkProdEnv.js",
    "prebuild": "pnpm run check:prod-env",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.94",
    "@vitejs/plugin-react": "latest",
    "convex": "^1.39.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "convex-test": "^0.0.53",
    "jsdom": "^29.1.1",
    "typescript": "latest",
    "vitest": "^4.1.8"
  }
}
